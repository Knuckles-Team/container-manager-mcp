# Surface contracts of container-manager-mcp: tool-use contracts, prompt/skill/tool
# links, data locations and business roles, typed by the scion-sdk contract vocabulary
# (every class extends a medulla core class; nothing is imported).
@prefix : <https://knuckles-team.github.io/ontology/connector/container-manager#> .
@prefix core: <https://knuckles-team.github.io/ontology/core#> .
@prefix sc: <https://knuckles-team.github.io/ontology/surface-contract#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:scion:container-manager-mcp:contract:apply-manifest>
    a sc:ToolUseContract ;
    core:hasStep <urn:scion:container-manager-mcp:step:apply-manifest.1> ;
    core:hasStep <urn:scion:container-manager-mcp:step:apply-manifest.2> ;
    core:hasStep <urn:scion:container-manager-mcp:step:apply-manifest.3> ;
    rdfs:comment "Server-side apply a manifest and prove the cluster now matches it." ;
    sc:forTask <urn:scion:container-manager-mcp:task:apply-manifest> .

<urn:scion:container-manager-mcp:contract:change-and-roll-back>
    a sc:ToolUseContract ;
    core:hasStep <urn:scion:container-manager-mcp:step:change-and-roll-back.1> ;
    core:hasStep <urn:scion:container-manager-mcp:step:change-and-roll-back.2> ;
    core:hasStep <urn:scion:container-manager-mcp:step:change-and-roll-back.3> ;
    core:hasStep <urn:scion:container-manager-mcp:step:change-and-roll-back.4> ;
    rdfs:comment "Change a workload, watch the rollout and return to the previous revision if it fails." ;
    sc:forTask <urn:scion:container-manager-mcp:task:change-and-roll-back> .

<urn:scion:container-manager-mcp:contract:delete-object>
    a sc:ToolUseContract ;
    core:hasStep <urn:scion:container-manager-mcp:step:delete-object.1> ;
    rdfs:comment "Delete any object by apiVersion and kind, with confirmation." ;
    sc:forTask <urn:scion:container-manager-mcp:task:delete-object> .

<urn:scion:container-manager-mcp:contract:force-sync-external-secret>
    a sc:ToolUseContract ;
    core:hasStep <urn:scion:container-manager-mcp:step:force-sync-external-secret.1> ;
    core:hasStep <urn:scion:container-manager-mcp:step:force-sync-external-secret.2> ;
    rdfs:comment "Make an ExternalSecret re-read its store now and prove the target Secret was rebuilt." ;
    sc:forTask <urn:scion:container-manager-mcp:task:force-sync-external-secret> .

<urn:scion:container-manager-mcp:contract:inspect-cluster>
    a sc:ToolUseContract ;
    core:hasStep <urn:scion:container-manager-mcp:step:inspect-cluster.1> ;
    core:hasStep <urn:scion:container-manager-mcp:step:inspect-cluster.2> ;
    core:hasStep <urn:scion:container-manager-mcp:step:inspect-cluster.3> ;
    rdfs:comment "Health of every node, pod and recent event across all namespaces." ;
    sc:forTask <urn:scion:container-manager-mcp:task:inspect-cluster> .

<urn:scion:container-manager-mcp:contract:map-data-locations>
    a sc:ToolUseContract ;
    core:hasStep <urn:scion:container-manager-mcp:step:map-data-locations.1> ;
    rdfs:comment "Which node and host path hold each volume's data." ;
    sc:forTask <urn:scion:container-manager-mcp:task:map-data-locations> .

<urn:scion:container-manager-mcp:contract:persist-setting-to-services>
    a sc:ToolUseContract ;
    core:hasStep <urn:scion:container-manager-mcp:step:persist-setting-to-services.1> ;
    core:hasStep <urn:scion:container-manager-mcp:step:persist-setting-to-services.2> ;
    rdfs:comment "Export a live object as a clean manifest for services/<name>/k8s/ and confirm no drift after the commit." ;
    sc:forTask <urn:scion:container-manager-mcp:task:persist-setting-to-services> .

<urn:scion:container-manager-mcp:contract:read-secret-metadata>
    a sc:ToolUseContract ;
    core:hasStep <urn:scion:container-manager-mcp:step:read-secret-metadata.1> ;
    rdfs:comment "Read a Secret's key names and digest; values only with reveal=true." ;
    sc:forTask <urn:scion:container-manager-mcp:task:read-secret-metadata> .

<urn:scion:container-manager-mcp:contract:restart-workload>
    a sc:ToolUseContract ;
    core:hasStep <urn:scion:container-manager-mcp:step:restart-workload.1> ;
    core:hasStep <urn:scion:container-manager-mcp:step:restart-workload.2> ;
    rdfs:comment "Restart every pod of a Deployment, StatefulSet or DaemonSet." ;
    sc:forTask <urn:scion:container-manager-mcp:task:restart-workload> .

<urn:scion:container-manager-mcp:contract:scale-workload>
    a sc:ToolUseContract ;
    core:hasStep <urn:scion:container-manager-mcp:step:scale-workload.1> ;
    core:hasStep <urn:scion:container-manager-mcp:step:scale-workload.2> ;
    rdfs:comment "Scale a Deployment and wait until the rollout completes." ;
    sc:forTask <urn:scion:container-manager-mcp:task:scale-workload> .

<urn:scion:container-manager-mcp:contract:troubleshoot-workload>
    a sc:ToolUseContract ;
    core:hasStep <urn:scion:container-manager-mcp:step:troubleshoot-workload.1> ;
    core:hasStep <urn:scion:container-manager-mcp:step:troubleshoot-workload.2> ;
    core:hasStep <urn:scion:container-manager-mcp:step:troubleshoot-workload.3> ;
    rdfs:comment "Find why a workload is unhealthy from its description, pods and logs." ;
    sc:forTask <urn:scion:container-manager-mcp:task:troubleshoot-workload> .

<urn:scion:container-manager-mcp:location:cluster-api>
    a sc:DataLocation ;
    rdfs:label "cluster-api" ;
    sc:federationKey "namespace/name" ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#ConfigMap> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#CustomResourceDefinition> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#DaemonSet> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#Deployment> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#ExternalSecret> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#Ingress> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#K8sCluster> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#K8sCronJob> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#K8sEvent> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#K8sJob> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#K8sNode> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#K8sSecret> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#K8sService> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#Namespace> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#PersistentVolumeClaim> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#Pod> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#ReplicaSet> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#StatefulSet> ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#StorageClass> ;
    sc:instance "in-cluster" ;
    sc:readTool <urn:scion:container-manager-mcp:tool:k8s_get_resource> ;
    sc:routeParam "context" ;
    sc:store "kubernetes API server (etcd)" .

<urn:scion:container-manager-mcp:location:node-local-volumes>
    a sc:DataLocation ;
    rdfs:label "node-local-volumes" ;
    sc:federationKey "node" ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#PersistentVolume> ;
    sc:instance "per K8sNode (hostname = inventory host alias)" ;
    sc:readTool <urn:scion:container-manager-mcp:tool:k8s_cluster_topology> ;
    sc:routeParam "context" ;
    sc:store "node disk host path" .

<urn:scion:container-manager-mcp:location:secret-store>
    a sc:DataLocation ;
    rdfs:label "secret-store" ;
    sc:federationKey "namespace/name" ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#ExternalSecret> ;
    sc:instance "openbao ClusterSecretStore" ;
    sc:readTool <urn:scion:container-manager-mcp:tool:k8s_list_external_secrets> ;
    sc:routeParam "context" ;
    sc:store "KV v2 path named by the ExternalSecret" .

<urn:scion:container-manager-mcp:location:services-manifests>
    a sc:DataLocation ;
    rdfs:label "services-manifests" ;
    sc:federationKey "kind/namespace/name" ;
    sc:holdsClass <https://knuckles-team.github.io/ontology/connector/container-manager#ServicesManifest> ;
    sc:instance "services/<name> git repository" ;
    sc:readTool <urn:scion:container-manager-mcp:tool:k8s_diff_manifest> ;
    sc:routeParam "manifest_yaml" ;
    sc:store "k8s/*.yaml" .

<urn:scion:container-manager-mcp:prompt:kubernetes-operator>
    a core:Prompt ;
    rdfs:label "kubernetes-operator" ;
    sc:agentKind "operator" ;
    sc:readsLocation <urn:scion:container-manager-mcp:location:cluster-api> ;
    sc:readsLocation <urn:scion:container-manager-mcp:location:node-local-volumes> ;
    sc:readsLocation <urn:scion:container-manager-mcp:location:secret-store> ;
    sc:readsLocation <urn:scion:container-manager-mcp:location:services-manifests> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:apply-manifest> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:change-and-roll-back> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:delete-object> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:force-sync-external-secret> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:inspect-cluster> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:map-data-locations> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:persist-setting-to-services> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:read-secret-metadata> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:restart-workload> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:scale-workload> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:troubleshoot-workload> ;
    sc:usesSkill <urn:scion:container-manager-mcp:skill:container-manager-externalsecret-sync> ;
    sc:usesSkill <urn:scion:container-manager-mcp:skill:container-manager-gitops-persist> ;
    sc:usesSkill <urn:scion:container-manager-mcp:skill:container-manager-k8s-change-validation> ;
    sc:usesSkill <urn:scion:container-manager-mcp:skill:container-manager-kubernetes-operations> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_apply_manifest> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_cluster_topology> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_delete_resource> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_describe_deployment> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_diff_manifest> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_export_manifest> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_force_sync_external_secret> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_get_resource> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_get_secret> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_list_events> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_list_external_secrets> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_list_nodes> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_list_pods> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_patch_resource> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_read_pod_logs> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_rollout_history> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_rollout_restart> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_rollout_status> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_rollout_undo> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_scale_deployment> ;
    sc:writesLocation <urn:scion:container-manager-mcp:location:cluster-api> ;
    sc:writesLocation <urn:scion:container-manager-mcp:location:services-manifests> .

<urn:scion:container-manager-mcp:prompt:platform-reliability-engineer>
    a core:Prompt ;
    rdfs:label "platform-reliability-engineer" ;
    sc:agentKind "business-role" ;
    sc:businessRole <urn:scion:container-manager-mcp:role:platform-reliability> ;
    sc:readsLocation <urn:scion:container-manager-mcp:location:cluster-api> ;
    sc:readsLocation <urn:scion:container-manager-mcp:location:secret-store> ;
    sc:readsLocation <urn:scion:container-manager-mcp:location:services-manifests> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:change-and-roll-back> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:force-sync-external-secret> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:inspect-cluster> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:map-data-locations> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:persist-setting-to-services> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:restart-workload> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:scale-workload> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:troubleshoot-workload> ;
    sc:usesSkill <urn:scion:container-manager-mcp:skill:container-manager-externalsecret-sync> ;
    sc:usesSkill <urn:scion:container-manager-mcp:skill:container-manager-gitops-persist> ;
    sc:usesSkill <urn:scion:container-manager-mcp:skill:container-manager-kubernetes-operations> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_cluster_topology> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_describe_deployment> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_diff_manifest> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_export_manifest> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_force_sync_external_secret> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_get_resource> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_list_events> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_list_external_secrets> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_list_nodes> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_list_pods> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_patch_resource> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_read_pod_logs> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_rollout_history> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_rollout_restart> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_rollout_status> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_rollout_undo> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_scale_deployment> ;
    sc:writesLocation <urn:scion:container-manager-mcp:location:cluster-api> ;
    sc:writesLocation <urn:scion:container-manager-mcp:location:services-manifests> .

<urn:scion:container-manager-mcp:refusal:change-and-roll-back.4.no-revision>
    a sc:Refusal ;
    sc:refusalCode "no-revision" ;
    sc:refusalWhen "the requested or previous revision does not exist" .

<urn:scion:container-manager-mcp:refusal:delete-object.1.cancelled>
    a sc:Refusal ;
    sc:refusalCode "cancelled" ;
    sc:refusalWhen "a destructive call without confirm=true" .

<urn:scion:container-manager-mcp:refusal:delete-object.1.not-found>
    a sc:Refusal ;
    sc:refusalCode "not-found" ;
    sc:refusalWhen "the named object does not exist in the namespace" .

<urn:scion:container-manager-mcp:refusal:force-sync-external-secret.2.not-found>
    a sc:Refusal ;
    sc:refusalCode "not-found" ;
    sc:refusalWhen "the named object does not exist in the namespace" .

<urn:scion:container-manager-mcp:refusal:inspect-cluster.1.not-entitled>
    a sc:Refusal ;
    sc:refusalCode "not-entitled" ;
    sc:refusalWhen "the caller's identity grants no k8s context" .

<urn:scion:container-manager-mcp:refusal:persist-setting-to-services.1.secret-refused>
    a sc:Refusal ;
    sc:refusalCode "secret-refused" ;
    sc:refusalWhen "a Secret; persist its ExternalSecret instead" .

<urn:scion:container-manager-mcp:refusal:scale-workload.1.not-found>
    a sc:Refusal ;
    sc:refusalCode "not-found" ;
    sc:refusalWhen "the named object does not exist in the namespace" .

<urn:scion:container-manager-mcp:refusal:troubleshoot-workload.1.not-found>
    a sc:Refusal ;
    sc:refusalCode "not-found" ;
    sc:refusalWhen "the named object does not exist in the namespace" .

<urn:scion:container-manager-mcp:refusal:troubleshoot-workload.3.not-found>
    a sc:Refusal ;
    sc:refusalCode "not-found" ;
    sc:refusalWhen "the named object does not exist in the namespace" .

<urn:scion:container-manager-mcp:role:platform-reliability>
    a sc:BusinessRole ;
    rdfs:comment "Keeps the self-hosted platform healthy and identical to its services/ manifests." ;
    rdfs:label "platform-reliability" ;
    sc:servesTask <urn:scion:container-manager-mcp:task:change-and-roll-back> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:force-sync-external-secret> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:inspect-cluster> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:map-data-locations> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:persist-setting-to-services> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:restart-workload> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:scale-workload> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:troubleshoot-workload> .

<urn:scion:container-manager-mcp:skill:container-manager-externalsecret-sync>
    a core:Skill ;
    rdfs:label "container-manager-externalsecret-sync" ;
    sc:servesTask <urn:scion:container-manager-mcp:task:force-sync-external-secret> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:read-secret-metadata> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_force_sync_external_secret> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_get_secret> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_list_external_secrets> .

<urn:scion:container-manager-mcp:skill:container-manager-gitops-persist>
    a core:Skill ;
    rdfs:label "container-manager-gitops-persist" ;
    sc:servesTask <urn:scion:container-manager-mcp:task:apply-manifest> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:persist-setting-to-services> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_apply_manifest> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_diff_manifest> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_export_manifest> .

<urn:scion:container-manager-mcp:skill:container-manager-k8s-change-validation>
    a core:Skill ;
    rdfs:label "container-manager-k8s-change-validation" ;
    sc:servesTask <urn:scion:container-manager-mcp:task:apply-manifest> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:change-and-roll-back> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:delete-object> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:restart-workload> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:scale-workload> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_apply_manifest> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_delete_resource> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_diff_manifest> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_patch_resource> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_rollout_history> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_rollout_restart> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_rollout_status> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_rollout_undo> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_scale_deployment> .

<urn:scion:container-manager-mcp:skill:container-manager-kubernetes-operations>
    a core:Skill ;
    rdfs:label "container-manager-kubernetes-operations" ;
    sc:servesTask <urn:scion:container-manager-mcp:task:inspect-cluster> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:map-data-locations> ;
    sc:servesTask <urn:scion:container-manager-mcp:task:troubleshoot-workload> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_cluster_topology> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_describe_deployment> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_list_events> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_list_nodes> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_list_pods> ;
    sc:usesTool <urn:scion:container-manager-mcp:tool:k8s_read_pod_logs> .

<urn:scion:container-manager-mcp:step:apply-manifest.1>
    a sc:ToolStep ;
    core:precedes <urn:scion:container-manager-mcp:step:apply-manifest.2> ;
    sc:callsTool <urn:scion:container-manager-mcp:tool:k8s_diff_manifest> ;
    sc:param "manifest_yaml" ;
    sc:param "namespace" ;
    sc:resultField "drift" ;
    sc:resultField "live" ;
    sc:resultField "paths" ;
    sc:stepOrder 1 .

<urn:scion:container-manager-mcp:step:apply-manifest.2>
    a sc:ToolStep ;
    core:precedes <urn:scion:container-manager-mcp:step:apply-manifest.3> ;
    sc:callsTool <urn:scion:container-manager-mcp:tool:k8s_apply_manifest> ;
    sc:param "dry_run" ;
    sc:param "force_conflicts" ;
    sc:param "manifest_yaml" ;
    sc:param "namespace" ;
    sc:resultField "kind" ;
    sc:resultField "name" ;
    sc:resultField "namespace" ;
