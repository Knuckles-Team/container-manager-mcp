@prefix ac: <https://knuckles-team.github.io/ontology/access#> .
@prefix : <https://knuckles-team.github.io/ontology/connector/container-manager#> .
@prefix cm: <https://knuckles-team.github.io/ontology/connector/container-access#> .

cm:deploymentAccess a ac:AccessContract ;
    ac:classIri :Deployment ;
    ac:sourceId "container-manager-mcp" ;
    ac:entity "deployment" ;
    ac:keyField "id" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "k8s_list_services" ;
    ac:pagination "none" .

cm:name a ac:PropertyBinding ;
    ac:contract cm:deploymentAccess ; ac:property :name ; ac:field "name" .
cm:status a ac:PropertyBinding ;
    ac:contract cm:deploymentAccess ; ac:property :deploymentStatus ; ac:field "status" .
cm:image a ac:PropertyBinding ;
    ac:contract cm:deploymentAccess ; ac:property :deploymentImageReference ; ac:field "image" .

cm:podAccess a ac:AccessContract ;
    ac:classIri :Pod ;
    ac:sourceId "container-manager-mcp" ;
    ac:entity "pod" ;
    ac:keyField "name" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "k8s_list_pods" ;
    ac:parameter "namespace", "label_selector", "all_namespaces" ;
    ac:pagination "none" ;
    ac:pushdown "filter" ;
    ac:freshnessSeconds 30 ;
    ac:costHint "low" .

cm:podName a ac:PropertyBinding ;
    ac:contract cm:podAccess ; ac:property :name ; ac:field "name" .
cm:podPhase a ac:PropertyBinding ;
    ac:contract cm:podAccess ; ac:property :podPhase ; ac:field "status" .

cm:nodeAccess a ac:AccessContract ;
    ac:classIri :K8sNode ;
    ac:sourceId "container-manager-mcp" ;
    ac:entity "node" ;
    ac:keyField "hostname" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "k8s_list_nodes" ;
    ac:pagination "none" ;
    ac:freshnessSeconds 60 ;
    ac:costHint "low" .

cm:nodeName a ac:PropertyBinding ;
    ac:contract cm:nodeAccess ; ac:property :name ; ac:field "hostname" .
cm:nodeRole a ac:PropertyBinding ;
    ac:contract cm:nodeAccess ; ac:property :nodeRole ; ac:field "role" .

cm:externalSecretAccess a ac:AccessContract ;
    ac:classIri :ExternalSecret ;
    ac:sourceId "container-manager-mcp" ;
    ac:entity "externalsecret" ;
    ac:keyField "name" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "k8s_list_external_secrets" ;
    ac:parameter "namespace", "all_namespaces" ;
    ac:pagination "none" ;
    ac:freshnessSeconds 300 ;
    ac:costHint "low" .

cm:externalSecretName a ac:PropertyBinding ;
    ac:contract cm:externalSecretAccess ; ac:property :name ; ac:field "name" .
cm:externalSecretStore a ac:PropertyBinding ;
    ac:contract cm:externalSecretAccess ; ac:property :secretStoreName ; ac:field "store" .

cm:containerAccess a ac:AccessContract ;
    ac:classIri <https://knuckles-team.github.io/ontology/infrastructure#Container> ;
    ac:sourceId "container-manager-mcp" ;
    ac:entity "container" ;
    ac:keyField "id" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "docker_list_containers" ;
    ac:pagination "none" ;
    ac:freshnessSeconds 30 ;
    ac:costHint "low" .

cm:containerName a ac:PropertyBinding ;
    ac:contract cm:containerAccess ; ac:property :name ; ac:field "name" .
cm:containerStatus a ac:PropertyBinding ;
    ac:contract cm:containerAccess ; ac:property :containerStatus ; ac:field "status" .

cm:imageAccess a ac:AccessContract ;
    ac:classIri <https://knuckles-team.github.io/ontology/infrastructure#ContainerImage> ;
    ac:sourceId "container-manager-mcp" ;
    ac:entity "image" ;
    ac:keyField "id" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "docker_list_images" ;
    ac:pagination "none" ;
    ac:freshnessSeconds 300 ;
    ac:costHint "low" .

cm:imageRepository a ac:PropertyBinding ;
    ac:contract cm:imageAccess ; ac:property :imageRepository ; ac:field "repository" .
cm:imageTag a ac:PropertyBinding ;
    ac:contract cm:imageAccess ; ac:property :imageTag ; ac:field "tag" .
